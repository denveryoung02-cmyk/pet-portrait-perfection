{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pawtoons-staging",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "index.js",
  "assets": {
    "directory": "../client"
