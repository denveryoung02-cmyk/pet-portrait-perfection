# ─── Supabase ───────────────────────────────────────────────────────
# Public — safe to expose in browser bundles.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side — never expose to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ─── OpenAI API ─────────────────────────────────────────────────────
# Get your API key from: https://platform.openai.com/api-keys
# Used by src/lib/generations.functions.ts for AI image generation.
# Two-step process: GPT-4 Vision (analyze pet) + DALL-E 3 (generate portrait)
OPENAI_API_KEY=

# ─── Stripe ─────────────────────────────────────────────────────────
# Public — safe in browser.
VITE_STRIPE_PUBLISHABLE_KEY=
# Server-side only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
