# ─── Lovable Cloud (auto-provisioned) ───────────────────────────────
# Public — safe to expose in browser bundles.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side — never expose to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ─── Lovable AI Gateway (auto-provisioned) ──────────────────────────
# Used by src/lib/generations.functions.ts for image generation.
LOVABLE_API_KEY=

# ─── Stripe (add via Lovable Cloud → Secrets when wiring checkout) ──
# Public — safe in browser.
VITE_STRIPE_PUBLISHABLE_KEY=
# Server-side only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── (Optional) BYOK OpenAI — only if you swap off Lovable AI ──────
# OPENAI_API_KEY=
